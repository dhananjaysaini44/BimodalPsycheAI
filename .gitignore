# Environment / secrets
.env
.env.local
*.env

# Databases
*.db
*.sqlite

# Datasets — E-DAIC/MDDInterview must never be committed (data-use agreement)
ml-training/datasets/*
!ml-training/datasets/README.md

# Trained model artifacts — too large for git, and may embed dataset traces
ml-engine/models/*.pkl
ml-engine/models/*.pt
ml-engine/models/*.h5
!ml-engine/models/README.md

# Audio files (encrypted at rest, but shouldn't be in git regardless)
backend/uploads/
storage/

node_modules/
dist/
__pycache__/
*.pyc

# PDF Documents (synopsis, papers)
*.pdf

# Allow tracking of diagrams/markdowns, but exclude specific outputs if needed
# (Mermaid files .mermaid are allowed and tracked by default now that Architecture/ is not ignored)

